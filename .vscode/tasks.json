{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Z80Emu",
      "type": "shell",
      "command": "C:\\msys64\\ucrt64\\bin\\cmake.exe",
      "args": [
        "--build",
        "build-msys2"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Z80 tests",
      "type": "shell",
      "command": "C:\\msys64\\ucrt64\\bin\\ctest.exe",
      "args": [
        "--test-dir",
        "build-msys2",
        "--output-on-failure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": [
        "Build Z80Emu"
      ]
    }
  ]
}